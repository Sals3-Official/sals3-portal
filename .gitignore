# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...except the template, which holds variable names and no values. Teammates
# need it to know what to set, so it must be committable.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Obsidian per-person UI state (open tabs, pane layout) - not shared content
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json

# safety net: scripts/typecheck-clean-next.mjs's temp swap dir, in case
# it's ever left behind after an interrupted run
.next-typecheck-tmp-*

# Per-person Claude Code state (local permissions, session scratch). Machine
# config, not project source - the shared rules live in CLAUDE.md/AGENTS.md.
.claude/

# Local verify output. Written by an ad-hoc `npm run verify > .verify-local...`
# run, not by any committed script. These are untracked build noise that a
# `git add -A` would otherwise sweep into a commit.
.verify-local.*.log

# Agent turnover/instruction artifacts. These are prompts handed to an agent
# for one task, not project source - each one says to keep it untracked and
# out of every PR. Ignoring them makes that safe by default instead of relying
# on whoever runs `git add`.
CLAUDE_*.txt
CODEX_*.txt
