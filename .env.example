# Copy this file to `.env.local` and fill in real values.
# `.env.local` is ignored by git. Never commit real credentials.

# CJdropshipping API key, from the CJ dashboard (Authentication -> API key).
# Format: CJ<userNumber>@api@<32-character key>
# Used ONLY by `npm run bootstrap:cj`, which seeds/reconnects the Sals3
# Official Dropshipper's supplier connection and stores the key encrypted in
# Postgres. Nothing reads this at request time any more - the portal and the
# storefront feed both read the encrypted supplier connection instead.
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
CJ_API_KEY=

# CJdropshipping MCP server token. Not used by the REST integration.
CJ_MCP_TOKEN=

# Better Auth email/password + TOTP authentication.
# Generate a high-entropy secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Local-only escape hatch so signup works without a Resend account: when this
# is 1 and RESEND_API_KEY is unset, verification and password-reset links are
# logged to the dev server console instead of being emailed. Ignored when
# NODE_ENV=production.
AUTH_EMAIL_CONSOLE_FALLBACK=

# API key for Better Auth's hosted dashboard (the `dash()` plugin from
# @better-auth/infra). Issued by the Better Auth dashboard when connecting a
# project. The plugin forwards authentication events - sign-ins, sign-ups,
# verification, session activity, and request location - to Better Auth's
# servers, so treat this as an outbound data flow, not just a read-only
# console. Leave unset to keep the plugin inert; it warns once and boots.
BETTER_AUTH_API_KEY=

# Test-only bypass for local Playwright/dev smoke testing. Never set in
# production. When enabled outside production, this uses PORTAL_DEV_ROLE.
PORTAL_TEST_AUTH_BYPASS=
PORTAL_DEV_ROLE=

# Shared secret for the protected storefront feed used by sals3-ecommerce.
# Use the same value in sals3-ecommerce/.env.local.
SALS3_STOREFRONT_API_TOKEN=

# Temporary v1 pricing rule for CJ products shown on sals3-ecommerce.
# Supplier USD cents are converted to PHP centavos, then marked up.
#
# CJ_USD_TO_PHP_RATE is now only a FALLBACK. The live rate is fetched daily
# from the European Central Bank's published reference rates; this value is
# used only when every source fails and no rate has been fetched yet. Keep it
# roughly current anyway - it is the floor of correctness, not a spare tyre.
CJ_USD_TO_PHP_RATE=58
CJ_PRICE_MARKUP_PERCENT=30

# Spread added on top of the published mid-market rate, money-changer style.
# A quoted mid rate is not one anyone can transact at: paying CJ in dollars
# costs more than mid because the card/wallet takes its own spread.
# Sized from real published rail costs: PH credit card ~1.85% (1% card-network
# assessment + ~0.85% issuer FX), PayPal 3-4%. 2.5% covers the card case plus
# rate movement between daily ECB publications, and still sits under the 2-3%
# a money changer quotes.
# Lower this if the CJ wallet is topped up by wire transfer or Payoneer - CJ
# pays a 2-3% top-up bonus that offsets most of the FX cost.
CJ_FX_BUFFER_PERCENT=2.5

# Secret sent as `Authorization: Bearer <value>` when calling
# /api/internal/catalog/evaluate-tick. Generate a random value and set the
# same value as a Vercel project env var AND as this repo's `CRON_SECRET`
# GitHub Actions secret (see .github/workflows/evaluate-tick.yml - Vercel
# Hobby cannot run a 5-minute cron itself). The tick is rejected with 401
# when this is unset or does not match.
CRON_SECRET=

# Placeholder thresholds for the automated candidate-evaluation engine
# (src/modules/catalog/candidates/rules/policy.ts). NONE of these are an
# approved ADR-002 pilot rule pack or ADR-003 destination market - see
# hot.md. Leave unset to use the documented placeholder defaults.
CATALOG_MIN_PRICE_USD_CENTS=
CATALOG_MAX_PRICE_USD_CENTS=
CATALOG_ESTIMATED_OVERHEAD_PERCENT=
CATALOG_MIN_MARGIN_PERCENT=
CATALOG_ABNORMAL_PRICE_CHANGE_PERCENT=

# AES-256-GCM master key for encrypting supplier credentials (ADR-008
# Supplier Apps - src/lib/secrets/crypto.ts). Must be exactly 32 bytes,
# base64-encoded. Generate with:
#   openssl rand -base64 32
# Losing/rotating this key makes every stored supplier_connection_secrets
# row undecryptable - back it up like any other production secret, never
# commit a real value.
SUPPLIER_CREDENTIAL_MASTER_KEY_BASE64=

# Postgres connection for the catalog tables (Drizzle ORM + postgres.js).
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
# Use a dedicated least-privilege role, never the postgres superuser:
#   createuser sals3_app --pwprompt
#   createdb sals3 --owner sals3_app
# Then apply the checked-in migrations: npm run db:migrate
# Any non-localhost host is connected with ssl='verify-full' (see
# src/lib/db/client.ts), so a remote database needs a valid certificate.
DATABASE_URL=postgresql://sals3_app:<password>@localhost:5432/sals3
